#!/bin/zsh
# gate_watch.sh — DURABLE corefill gate/finals watch. Pays the D2 instrument
# debt from s37 (the session-tied watcher died with its session and AMMO0 ran
# through both futility gates unwatched, ~4,400 games wasted).
#
# WHAT IT DOES: for every shard in the worklist, compares the shard TSV's row
# count against the gate boundaries (1000 / 2700 / final target from the
# worklist's n column) and the typed-gate ledger scratchpad/gate_watch_state.txt
# (lines `SHARD:1000`, `SHARD:2700`, `SHARD:DONE`). The moment a boundary is
# crossed that has no ledger entry, it PRINTS the numbers and EXITS — run it as
# a session background task and the exit IS the wake. The watcher never
# decides; the builder types the gate (RULE-futility-gates-2026-08-13).
#
# s37 FALLTHROUGH FIX ENCODED: a shard past 2700 with no 1000 entry wakes for
# GATE-2700 ONLY (never a spurious GATE-1000); typing the 2700 gate records
# BOTH lines in the ledger.
#
# 2026-08-14 FIXES (task #8 boundary work):
#   - DONE-FALLTHROUGH: SHARD:DONE now silences ALL bands, not only FINAL. A
#     target-1000 shard whose ledger had only :DONE (no separate :1000 entry,
#     since target==1000 means FINAL and the mid-band are the same crossing)
#     used to fall through the elif chain (checked by n, not by completion)
#     and fire a stale GATE-1000.
#   - RE-ARM RACE: immediately before printing the wake block, filter_survivors()
#     re-greps the ledger for every due shard:token found by scan() and drops
#     any typed in the interim (~8 redundant wakes observed 2026-08-14 from
#     instances scanning seconds before a ledger write). If nothing survives,
#     the loop continues instead of exiting.
#   - DRAFT-ROW: the wake block now prints a ready-to-append results.tsv row
#     template per surviving due gate. Tab-separated to match results.tsv's
#     schema (commit, winrate, ci_low, ci_high, n, status, description). The
#     builder confirms/edits — this is never auto-appended.
#
# BLIND RULE: unreadable worklist/TSV dir => prints BLIND and exits 2 rather
# than reporting quiet health. Every wake line carries the TSV's age (the
# freshness rule: a healthy line and a blind line must not be byte-identical).
#
# MODES:  --check      single pass, print any due gates, exit 0 (3 if due)
#         --selftest   fixture drive, both verdicts per guard
#         (default)    loop every $POLL s until a gate is due, print, exit 0
cd "$(dirname "$0")/../.." || exit 2

WORK=${WORK:-scratchpad/corefill_work.txt}
TSVDIR=${TSVDIR:-scratchpad/overnight}
STATE=${STATE:-scratchpad/gate_watch_state.txt}
POLL=${POLL:-120}

scan() {  # prints one line per due gate; returns 0 if none due, 3 if any
  [[ -r $WORK && -d $TSVDIR ]] || { echo "BLIND: worklist or TSV dir unreadable ($WORK / $TSVDIR)"; return 2; }
  local due=0
  grep -v '^#' "$WORK" | while read -r shard tree ctrl target seed rest; do
    [[ -n $shard && $target == <-> ]] || continue
    local tsv="$TSVDIR/$shard.tsv"
    [[ -f $tsv ]] || continue
    local n= wins= age= gate="" token="" gate_n=
    n=$(( $(wc -l < "$tsv") - 1 ))
    (( n < 1 )) && continue
    # DONE-FALLTHROUGH FIX (2026-08-14): SHARD:DONE silences ALL bands,
    # regardless of n. Previously only the FINAL check looked at :DONE, so a
    # target-1000 shard marked :DONE (with no separate :1000 entry) fell
    # through to the GATE-1000 elif and fired a stale wake.
    if grep -q "^$shard:DONE$" "$STATE" 2>/dev/null; then
      :  # done -- silent for every band
    elif (( n >= target )); then
      gate="FINAL"; token="DONE"; gate_n=$target
    elif (( n >= 2700 )) && ! grep -q "^$shard:2700$" "$STATE" 2>/dev/null; then
      gate="GATE-2700"; token="2700"; gate_n=2700   # covers a missing 1000 too — never a spurious GATE-1000 (s37 fix)
    elif (( n >= 1000 )) && (( n < 2700 )) && ! grep -q "^$shard:1000$" "$STATE" 2>/dev/null; then
      gate="GATE-1000"; token="1000"; gate_n=1000
    elif (( n >= 400 )) && (( n < 1000 )) && ! grep -q "^$shard:400$" "$STATE" 2>/dev/null; then
      # CATASTROPHE GATE (s39, Magnus: "any reason we continue it across 1000
      # ... when it's so far below 50%?"). NOAPPROACH ran to 2,264 rows at
      # 18.55% because nothing looked before 1000. Wake ONLY when the share
      # reads under 42 at n in [400,1000) — the typed bar is <40 (a true-50%
      # arm crosses it with p ~ 3e-5 even before correlation inflation, so the
      # extra look spends ~no alpha); 42 wakes the builder ahead of the bar.
      # The watcher still never decides: it wakes, the builder types.
      local w4=$(awk -F'\t' 'NR>1 && $7=="T"' "$tsv" | wc -l | tr -d ' ')
      if (( 100 * w4 < 42 * n )); then
        gate="GATE-400-CATA"; token="400"; gate_n=400
      fi
    fi
    if [[ -n $gate ]]; then
      wins=$(awk -F'\t' 'NR>1 && $7=="T"' "$tsv" | wc -l | tr -d ' ')
      age=$(( $(date +%s) - $(stat -f %m "$tsv") ))
      local share=$(awk -v w="$wins" -v n="$n" 'BEGIN{printf "%.2f", 100*w/n}')
      printf 'DUE %-12s %-9s n=%d/%d  T-share=%s%%  tsv_age=%ds\n' \
        "$shard" "$gate" "$n" "$target" "$share" "$age"
      echo DUE >> "${SCAN_FLAG:-/dev/null}"
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$shard" "$token" "$gate" "$gate_n" "$n" "$share" >> "${RECORD_FLAG:-/dev/null}"
    fi
  done
  [[ -s ${SCAN_FLAG:-/dev/null} ]] && return 3 || return 0
}

filter_survivors() {  # RE-ARM RACE FIX (2026-08-14): re-checks each due
  # shard:token from RECORD_FLAG against the ledger RIGHT NOW, dropping any
  # typed in the gap between scan() and the print step (~8 redundant wakes
  # observed 2026-08-14 from instances that scanned seconds before a ledger
  # write). Prints surviving records in the same tab-separated shape scan()
  # wrote them in; caller treats an empty result as "nothing left to wake for".
  local any=1
  while IFS=$'\t' read -r shard token gate gate_n n share; do
    [[ -n $shard ]] || continue
    if grep -q "^$shard:$token$" "$STATE" 2>/dev/null; then
      continue  # typed in the interim -- drop, do not re-announce
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$shard" "$token" "$gate" "$gate_n" "$n" "$share"
    any=0
  done < "${RECORD_FLAG:-/dev/null}"
  return $any
}

draft_rows() {  # DRAFT-ROW FIX (2026-08-14): one results.tsv-shaped template
  # line per surviving due gate (commit, winrate, ci_low, ci_high, n, status,
  # description) -- tab-separated, empty ci_low/ci_high, status "gate". The
  # builder confirms/edits every field; this is never auto-appended anywhere.
  while IFS=$'\t' read -r shard token gate gate_n n share; do
    [[ -n $shard ]] || continue
    printf 'DRAFT-ROW: %s-gate%s\t0.%s\t\t\t%s\tgate\t%s GATE-%s %s — [builder types the verdict]\n' \
      "$shard" "$gate_n" "$share" "$n" "$shard" "$gate_n" "$share"
  done
}

if [[ "$1" == "--selftest" ]]; then
  FIX=$(mktemp -d); fail=0
  mkfixture() {  # $1 shard, $2 rows, tsv with $2 data rows, T winner on evens
    { echo "ts\tshard\tgame\tmap\tseed\tseat\twinner\tcond\tturns"
      for i in $(seq 1 $2); do
        if (( i % 2 == 0 )); then w=T; else w=C; fi
        echo "2026-08-14T00:00:00Z\t$1\t$i\tm\t1\tA\t$w\tx\t100"
      done } > "$FIX/tsv/$1.tsv"
  }
  mkfixture_lo() {  # $1 shard, $2 rows: T wins only every 10th row (10% share)
    { echo "ts\tshard\tgame\tmap\tseed\tseat\twinner\tcond\tturns"
      for i in $(seq 1 $2); do
        if (( i % 10 == 0 )); then w=T; else w=C; fi
        echo "2026-08-14T00:00:00Z\t$1\t$i\tm\t1\tA\t$w\tx\t100"
      done } > "$FIX/tsv/$1.tsv"
  }
  mkdir -p "$FIX/tsv"; : > "$FIX/state"
  {
    echo "QUIETSHARD  bots/_a  bots/_b  5400  1"
    echo "EARLYSHARD  bots/_a  bots/_b  5400  1"
    echo "MIDSHARD    bots/_a  bots/_b  5400  1"
    echo "GRANDDADDY  bots/_a  bots/_b  5400  1"
    echo "FINALSHARD  bots/_a  bots/_b  5400  1"
    echo "TYPEDSHARD  bots/_a  bots/_b  5400  1"
    echo "CATASHARD   bots/_a  bots/_b  5400  1"
    echo "TYPEDCATA   bots/_a  bots/_b  5400  1"
    echo "DONESHARD   bots/_a  bots/_b  1000  1"
  } > "$FIX/work"
  mkfixture QUIETSHARD 999            # 50% inside [400,1000) -> silent (healthy band)
  mkfixture EARLYSHARD 1001           # -> GATE-1000
  mkfixture MIDSHARD 2750             # 1000 typed -> GATE-2700
  mkfixture GRANDDADDY 2750           # NOTHING typed -> GATE-2700 only, no spurious 1000
  mkfixture FINALSHARD 5400           # 1000+2700 typed -> FINAL
  mkfixture TYPEDSHARD 5400           # all typed -> silent
  mkfixture_lo CATASHARD 450          # 10% share at n=450 -> GATE-400-CATA
  mkfixture_lo TYPEDCATA 450          # same but :400 typed -> silent
  mkfixture DONESHARD 1005            # target==1000 shard, only :DONE typed (no :1000) -> must stay silent (D-fallthrough fix)
  printf 'MIDSHARD:1000\nFINALSHARD:1000\nFINALSHARD:2700\nTYPEDSHARD:1000\nTYPEDSHARD:2700\nTYPEDSHARD:DONE\nTYPEDCATA:400\nDONESHARD:DONE\n' > "$FIX/state"
  out=$(WORK="$FIX/work" TSVDIR="$FIX/tsv" STATE="$FIX/state" SCAN_FLAG="$FIX/flag" zsh "$0" --check)
  echo "$out"
  echo "$out" | grep -q "QUIETSHARD"                        && { echo "FAIL: quiet shard woke"; fail=1; }
  echo "$out" | grep -q "EARLYSHARD  *GATE-1000"            || { echo "FAIL: GATE-1000 did not fire"; fail=1; }
  echo "$out" | grep -q "MIDSHARD  *GATE-2700"              || { echo "FAIL: GATE-2700 did not fire"; fail=1; }
  echo "$out" | grep -q "GRANDDADDY  *GATE-2700"            || { echo "FAIL: grandfathered 2700 did not fire"; fail=1; }
  echo "$out" | grep -q "GRANDDADDY  *GATE-1000"            && { echo "FAIL: spurious GATE-1000 (s37 bug)"; fail=1; }
  echo "$out" | grep -q "FINALSHARD  *FINAL"                || { echo "FAIL: FINAL did not fire"; fail=1; }
  echo "$out" | grep -q "TYPEDSHARD"                        && { echo "FAIL: fully-typed shard woke"; fail=1; }
  echo "$out" | grep -q "CATASHARD  *GATE-400-CATA"         || { echo "FAIL: catastrophe gate did not fire at 10%/450"; fail=1; }
  echo "$out" | grep -q "QUIETSHARD"                        && { echo "FAIL: healthy 50% shard in [400,1000) woke"; fail=1; }
  echo "$out" | grep -q "TYPEDCATA"                         && { echo "FAIL: typed :400 shard woke again"; fail=1; }
  # DONE-fallthrough fix, both ways: a target-1000 shard past its target with
  # only :DONE typed (no separate :1000 entry) must stay fully silent -- the
  # s37-era bug fell through the elif-by-n chain and fired a stale GATE-1000.
  echo "$out" | grep -q "DONESHARD"                         && { echo "FAIL: DONE-typed target-1000 shard fired a stale gate (fallthrough bug)"; fail=1; }
  # blind branch: point at a missing dir
  bout=$(WORK="$FIX/work" TSVDIR="$FIX/nodir" STATE="$FIX/state" zsh "$0" --check)
  echo "$bout" | grep -q "BLIND"                            || { echo "FAIL: blind branch silent"; fail=1; }
  # D4 re-arm line, both directions: the WAKE path leads with it; --check does not carry it
  wout=$(WORK="$FIX/work" TSVDIR="$FIX/tsv" STATE="$FIX/state" POLL=1 zsh "$0")
  echo "$wout" | sed -n 2p | grep -q "^RE-ARM FIRST"        || { echo "FAIL: wake does not lead with the re-arm line (D4)"; fail=1; }
  echo "$out" | grep -q "RE-ARM"                            && { echo "FAIL: --check output carries the re-arm line"; fail=1; }
  # T-share arithmetic: 5400 rows, T on evens = exactly 50.00
  echo "$out" | grep "FINALSHARD" | grep -q "T-share=50.00" || { echo "FAIL: share arithmetic"; fail=1; }
  # DRAFT-ROW fix: the wake block prints a results.tsv-shaped template per
  # surviving due gate -- 7 tab-separated fields, status "gate", commit
  # "<shard>-gate<N>".
  draftline=$(echo "$wout" | grep "^DRAFT-ROW: EARLYSHARD-gate1000")
  [[ -n $draftline ]]                                       || { echo "FAIL: draft row missing for EARLYSHARD"; fail=1; }
  nf=$(echo "$draftline" | awk -F'\t' '{print NF}')
  (( nf == 7 ))                                              || { echo "FAIL: draft row field count wrong ($nf, want 7)"; fail=1; }
  echo "$draftline" | awk -F'\t' '{print $6}' | grep -qx "gate" || { echo "FAIL: draft row status field wrong"; fail=1; }
  echo "$draftline" | awk -F'\t' '{print $3}' | grep -qx ""     || { echo "FAIL: draft row ci_low not empty"; fail=1; }
  echo "$draftline" | awk -F'\t' '{print $4}' | grep -qx ""     || { echo "FAIL: draft row ci_high not empty"; fail=1; }
  echo "$wout" | grep -q "DRAFT-ROW: TYPEDSHARD"             && { echo "FAIL: draft row printed for a fully-typed (non-due) shard"; fail=1; }
  # RE-ARM RACE FIX, both ways, via filter_survivors() directly (a real
  # concurrent-write test would need to race two processes; this drives the
  # exact function the wake path calls, deterministically, both directions).
  # Isolated single-shard worklist -- reusing the full 9-shard $FIX/work
  # against an empty ledger would make EVERY shard due and the "after" check
  # would see the other shards' unrelated survivors, masking the drop.
  WORK_R="$FIX/work_redundant"
  echo "EARLYSHARD  bots/_a  bots/_b  5400  1" > "$WORK_R"
  RECFLAG="$FIX/records"; : > "$RECFLAG"
  STATE_R="$FIX/state_redundant"; : > "$STATE_R"
  WORK="$WORK_R" TSVDIR="$FIX/tsv" STATE="$STATE_R" SCAN_FLAG="$FIX/flag3" RECORD_FLAG="$RECFLAG" scan >/dev/null
  surv_before=$(STATE="$STATE_R" RECORD_FLAG="$RECFLAG" filter_survivors)
  echo "$surv_before" | grep -q "EARLYSHARD"                 || { echo "FAIL: redundant-wake pre-check found no survivor (setup broken)"; fail=1; }
  echo "EARLYSHARD:1000" >> "$STATE_R"   # simulate a ledger write landing between scan and print
  surv_after=$(STATE="$STATE_R" RECORD_FLAG="$RECFLAG" filter_survivors)
  [[ -z $surv_after ]]                                       || { echo "FAIL: redundant-wake did not drop EARLYSHARD typed in the interim"; fail=1; }
  rm -rf "$FIX"
  (( fail == 0 )) && echo "SELFTEST PASS (8 wake/quiet verdicts incl. catastrophe both ways + blind + share + D4 re-arm line both ways + DONE-fallthrough silence + draft-row shape + re-arm-race drop both ways)" || echo "SELFTEST FAIL"
  exit $fail
fi

if [[ "$1" == "--check" ]]; then
  SCAN_FLAG=${SCAN_FLAG:-$(mktemp)} ; export SCAN_FLAG
  scan; rc=$?
  [[ -s $SCAN_FLAG ]] && rc=3
  rm -f "$SCAN_FLAG" 2>/dev/null
  exit $rc
fi

echo "gate_watch armed $(date -u +%H:%M:%SZ): poll ${POLL}s, worklist $WORK, ledger $STATE"
while true; do
  SCAN_FLAG=$(mktemp); export SCAN_FLAG
  RECORD_FLAG=$(mktemp); export RECORD_FLAG
  out=$(scan); rc=$?
  if (( rc == 2 )); then echo "$out"; rm -f "$SCAN_FLAG" "$RECORD_FLAG"; exit 2; fi
  if [[ -s $SCAN_FLAG ]]; then
    # RE-ARM RACE FIX (2026-08-14): re-check every due shard:token against the
    # ledger RIGHT NOW, immediately before printing. Drops anything typed in
    # the gap since scan() ran (~8 redundant wakes observed 2026-08-14). If
    # nothing survives, resume polling instead of exiting.
    survivors=$(filter_survivors)
    if [[ -z $survivors ]]; then
      rm -f "$SCAN_FLAG" "$RECORD_FLAG"
      continue   # everything due was typed in the interim -- no wake
    fi
    # D4 (s38 retro): the manual re-arm step failed under ship-flow once — the
    # wake itself must carry the re-arm as its FIRST line. (A nohup'd successor
    # cannot wake a harness session, so self-respawn is not an option here.)
    echo "RE-ARM FIRST: relaunch 'zsh tools/monitors/gate_watch.sh' as a background task BEFORE typing any gate below (D4)"
    echo "=== GATE WAKE $(date -u +%Y-%m-%dT%H:%M:%SZ) — builder types the decision, watcher never decides ==="
    echo "$out"
    print -r -- "$survivors" | draft_rows
    rm -f "$SCAN_FLAG" "$RECORD_FLAG"; exit 0
  fi
  rm -f "$SCAN_FLAG" "$RECORD_FLAG"
  sleep "$POLL"
done
