+# =============================================================================
+# s51 DOUBLE-FERRY TIMING PROBE.  Not a ship candidate.
+# =============================================================================
+# ⛔ THE DEFECT THIS BLOCK EXISTS FOR -- A LOST UPDATE ON A BUFFERED STORE.
+# Store writes are buffered a round, so two units writing the SAME slot in the
+# same round both read LAST round's word and the later writer's word is the one
+# that lands.  With FS_CREW_ON both ferry-siege bodies run `_fs_publish`
+# (SLOT_FS: beat + phase + RAIDER ID) and `_fs_crew_publish` (FS_CREW_SLOT:
+# both seats' beats) every round.  Turn order is entity-id ascending, so the
+# SUPPORT (spawned later, higher id) writes last and wins BOTH slots every
+# round.  Two consequences, both measured in the as-built crew logs:
+#   1. the SEALER's crew beat never advances once the support exists, so
+#      `_fs_crew_age(seat 0)` crosses FS_CREW_STALE ~6 rounds after the support
+#      spawns and the support PROMOTES itself to sealer (drakkarfjord s1:
+#      `FS PROMOTE 10` at r10, with the sealer id 3 still ferrying at r10).
+#      After that there is no support body at all, and every later spawn also
+#      reads the sealer seat as stale.
+#   2. SLOT_FS carries ONE raider id, and `_fs_ferry_launcher` throws that id
+#      and nothing else.  The body that loses the write has a paid-for launcher
+#      standing beside it that refuses to pick it up.
+# THE PROBE FIX: give the support its own slot.  Nothing then has two writers.
+DF_SUPP_SLOT = SLOT_FERRY_ID    # slot 10, freed by LOKI_FERRY_ON = False
+# same field layout as SLOT_FS, so `_fs_state` reads either slot unchanged:
+#   bits 0-10 beat (round+1), 11-13 phase, 14-29 raider id + 1
+DF_LOG = True               # PROBE instrument: stderr DF lines, always on
+DF_POS_EVERY = 1            # a POS line every N rounds while a body is alive
+
+# --- THE RELAY (Magnus, s51 mid-build) --------------------------------------
+# "Both builders are launched before the launcher can be destroyed and a new
+# launcher can be built."  The as-built ferry throws ONE body and calls
+# self_destruct() in the same turn, so a crew of two builds TWO parallel chains
+# -- twice the launchers, twice the titanium, and (measured, drakkarfjord s1)
+# the two chains run three rounds apart down the same tiles.
+# THE MECHANICS, read off CLAUDE.md's engine table and confirmed in the logs:
+#   * a throw costs the launcher `cooldown += 1` and cooldowns decrement at END
+#     of round, so a launcher that throws in round R has cooldown 0 again in
+#     R+1: ONE throw per round, consecutive rounds legal, never two in one.
+#   * pickup is d^2 <= 2 from the launcher, throw 1 <= d^2 <= 26 from the
+#     launcher, 0 ammo, position-only mutation (the thrown body keeps its own
+#     action and move cooldowns).
+#   * self_destruct() is the launcher's OWN action and needs nobody adjacent;
+#     destroy() would need an allied builder orthogonally adjacent, and after a
+#     relay hop both bodies are five tiles away.  So teardown is self_destruct.
+#   * destroying the launcher removes its +10% cost-scale contribution, which
+#     is what keeps a long chain from pricing the sentinel out.  DF SCALE lines
+#     instrument that refund.
+# THE CYCLE: body 1 builds launcher L at R; L throws body 1 at R+1 and body 2
+# at R+2, then self-destructs; body 1 (landed R+1) builds the next launcher at
+# R+2 in the new zone.  Body 1 hops on even rounds, body 2 one round behind it,
+# and ONE launcher is paid for per hop instead of two.
+DF_RELAY_ON = True
+DF_RELAY_TTL = 3            # rounds a relay launcher waits for its second
+                            # rider before tearing down anyway
+# ⛔ THE MUSTER, AND IT IS THE ONLY THING THE FIRST LINK NEEDS.  Measured on the
+# first relay smoke run (drakkarfjord s1): the steady state is self-sustaining
+# -- link L throws the lead at R+1 and body 2 at R+2, body 2 lands beside the
+# lead's next link and rides it at R+4 -- but the FIRST link cannot reach that
+# state, because the lead spawns a round before body 2 and the chain then
+# leaves at 2.5 tiles a round against a walk of 1.  In that run body 2 was
+# never once inside a pickup envelope and walked the whole map.  So the lead
+# WAITS for the first link only, and never again.
+DF_MUSTER_DSQ = 4           # body 2 this close to the lead == mustered
+DF_MUSTER_WAIT = 8          # ...and the lead goes alone after this many rounds,
+                            # so a body 2 that never spawns cannot stall a siege
+DF_RELAY_PATIENCE = 6       # rounds body 2 will ride the relay with no throw
+                            # and no launcher in sight before it gives up and
+                            # builds its own chain (the safe degrade -- without
+                            # it a body 2 that loses the relay strands forever)
+
 FS_CREW_STALE = 6           # rounds without a crew beat before that seat is
                             # scored dead.  The cap Magnus set is ~15 rounds
                             # from death to a body engaging; 6 to notice plus
